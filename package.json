{
  "name": "deepseek-harness-manager",
  "version": "0.3.3",
  "description": "大肥鱼：DeepSeek Harness 桌面助手",
  "main": "./out/main/index.js",
  "author": "lcy",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --win",
    "test:desktop": "electron tests/desktop-smoke.cjs",
    "test:packaged": "node tests/packaged-smoke.cjs",
    "test:real-dsh": "electron tests/real-dsh-smoke.cjs"
  },
  "build": {
    "appId": "com.community.deepseek-harness-manager",
    "productName": "大肥鱼",
    "copyright": "Copyright © 2026 lcy",
    "directories": {
      "output": "release"
    },
    "artifactName": "DaFeiYu-${version}-Setup.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "luocuiyu",
        "repo": "deepseek-harness-manager"
      }
    ],
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "大肥鱼",
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "displayLanguageSelector": true
    }
  },
  "dependencies": {
    "dompurify": "^3.4.13",
    "electron-updater": "^6.8.9",
    "marked": "^18.0.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
